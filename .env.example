# Active provider selection: "auto", "gemini", or "openai"
# When set to "auto", provider is automatically detected based on which key is configured.
LLM_PROVIDER=auto

# Optional generic model override (applies to whichever provider is active)
# LLM_MODEL=

# Google Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI configuration (also compatible with Groq, DeepSeek, Together, Ollama, etc.)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# General configuration
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=15
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
LLM_TIMEOUT_SECONDS=45

